.DS_Store
**/*.pid
scratchpad/
*.orig
*.bak
*.tmp
*.new

# machine-local Claude Code permissions
.claude/settings.local.json

# safety net: TLS control material is retired (certless unix socket since
# b7c3dc7), but if keys/certs ever reappear, keep them out of history
config/unbound/*.key
config/unbound/*.pem

# machine-generated blocklist (~13 MB, clobbered daily by update-blocklist.sh);
# the hand-curated hagezi-allow.rpz stays tracked
config/unbound/blocklists/hagezi-normal.rpz

# personalized warmup lists derived from the live cache/query logs — these are
# a household behaviour profile, never commit them (build-warm-list.sh output)
**/dns-warm-domains.personal.txt

# one-off backup/debug archives dropped into the repo dir — never commit
*.tar.gz
*.zip

# Python bytecode cache, created when scripts/*.py are imported (e.g. running
# the exporter's unit tests or importing a module) — machine-generated, never commit
__pycache__/
*.pyc

# generated from DISASTER-RECOVERY.md via tools/render-disaster-recovery-pdf.py —
# the Markdown is the source of truth, regenerate the PDF anytime, never commit the binary
DISASTER-RECOVERY.pdf
tools/.dr-render-tmp.html
