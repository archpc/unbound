#!/bin/bash
#
# screenshare-off — disable macOS Screen Sharing (:5900) again.
#
# Deployed at /usr/local/sbin/screenshare-off. Run over SSH with sudo.
#
# Restores this box's secure default (Screen Sharing off) after a session
# opened with screenshare-on. The disable persists across reboots (launchctl
# writes to the override DB), so a reboot won't silently reopen :5900.
# See CLAUDE.md "Remote access / attack surface".

set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "screenshare-off: must run as root (use sudo)" >&2; exit 1; }

launchctl bootout system/com.apple.screensharing 2>/dev/null || true
launchctl disable system/com.apple.screensharing
sleep 1

if lsof -nP -iTCP:5900 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "screenshare-off: :5900 is still listening — something re-triggered it, investigate." >&2
    exit 1
else
    echo "Screen Sharing OFF — :5900 closed."
fi
