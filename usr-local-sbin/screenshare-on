#!/bin/bash
#
# screenshare-on — enable macOS Screen Sharing (:5900) on demand.
#
# Deployed at /usr/local/sbin/screenshare-on. Run over SSH with sudo.
#
# Screen Sharing is kept DISABLED by default on this box. It was closed on
# 2026-07-07 along with SMB (:445) and the local Kerberos KDC (:88) to shrink
# the LAN/tailnet attack surface — it's used only occasionally, so the secure
# default is "off, flip on for a session". This script re-enables the
# socket-activated com.apple.screensharing job; run screenshare-off when done.
#
# Auth note: with the local KDC also disabled, connections authenticate by
# password rather than Kerberos SSO — which is how a remote VNC login works
# anyway. See CLAUDE.md "Remote access / attack surface".

set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "screenshare-on: must run as root (use sudo)" >&2; exit 1; }

PLIST=/System/Library/LaunchDaemons/com.apple.screensharing.plist

launchctl enable    system/com.apple.screensharing
launchctl bootstrap system "$PLIST" 2>/dev/null || true
sleep 1

if lsof -nP -iTCP:5900 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Screen Sharing ON — listening on :5900. Close it with: sudo /usr/local/sbin/screenshare-off"
else
    echo "screenshare-on: job enabled but :5900 is not listening yet." >&2
    echo "  re-check: sudo lsof -nP -iTCP:5900 -sTCP:LISTEN" >&2
    exit 1
fi
