    {
      "id": 10,
      "title": "Backup age",
      "description": "Age of the latest completed backup from the privacy-safe Time Machine collector. It uses tmutil when permitted and completed SnapshotDates obtained through the macOS defaults preference service otherwise. NOT CONFIGURED is explicit; missing or stale collection remains UNKNOWN. Warning at six hours and critical at 24 hours are engineering limits based on the observed hourly schedule.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "UNKNOWN / STALE",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 21600
              },
              {
                "color": "red",
                "value": 86400
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "color": "gray",
                  "index": 0,
                  "text": "NOT CONFIGURED"
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - time_machine_latest_backup_timestamp_seconds) and on() (time() - node_textfile_mtime_seconds{file=~\".*/time-machine[.]prom\"} < 3600) or on() (((time_machine_destination_configured == 0) - 1) and on() (time() - node_textfile_mtime_seconds{file=~\".*/time-machine[.]prom\"} < 3600))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "links": [
        {
          "targetBlank": false,
          "title": "Backup drill-down",
          "url": "/d/host-services?${__url_time_range}"
        }
      ]
    },
