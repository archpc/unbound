      "id": 12,
      "title": "Independent outage witness",
      "description": "Static limitation, intentionally prominent rather than represented as a green metric.",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 3
