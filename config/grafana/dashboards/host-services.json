    {
      "id": 13,
      "title": "Current APFS/HFS filesystems",
      "description": "Instant current utilization by active APFS/HFS mountpoint, matching DiskAlmostFull's population without retaining transient historical mounts.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
