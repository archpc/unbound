<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.unbound.blackbox</string>
    <!-- Runs as localadmin, not root: DNS probes are plain UDP/TCP sockets.
         Loopback-only - Prometheus scrapes /probe locally. -->
    <key>UserName</key>
    <string>localadmin</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/blackbox_exporter</string>
        <string>--config.file=/opt/homebrew/etc/blackbox.yml</string>
        <string>--web.listen-address=127.0.0.1:9115</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/log/unbound-blackbox.log</string>
    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/log/unbound-blackbox.log</string>
</dict>
</plist>
