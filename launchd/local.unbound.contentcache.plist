<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Snapshot of /Library/LaunchDaemons/local.unbound.contentcache.plist -->
    <!-- Refreshes macOS Content Cache metrics for node_exporter's textfile collector. -->
    <key>Label</key>
    <string>local.unbound.contentcache</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/apple-content-cache-exporter</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>UserName</key>
    <string>localadmin</string>

    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/log/apple-content-cache-exporter.log</string>

    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/log/apple-content-cache-exporter.log</string>
</dict>
</plist>
