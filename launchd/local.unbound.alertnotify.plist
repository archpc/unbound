<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Periodic short-lived JOB, not a resident daemon: StartInterval
         spawns the script every 120s, it exits, done. No KeepAlive on
         purpose - that's for processes that should stay resident, and on
         a poller it would just respawn-loop at launchd's throttle rate.
         It lives in the system domain (/Library/LaunchDaemons) only
         because auto-login is OFF and user agents don't start on an
         unattended reboot - same rationale as every other job here.
         UserName keeps it unprivileged: it only reads the Prometheus API
         and POSTs to ntfy. Needs sudo to install; see CLAUDE.md. -->
    <key>Label</key>
    <string>local.unbound.alertnotify</string>
    <key>UserName</key>
    <string>localadmin</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/localadmin/monitoring/prometheus_alert_notifier.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/log/unbound-alertnotify.log</string>
    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/log/unbound-alertnotify.log</string>
</dict>
</plist>
