      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5368709120
              },
              {
                "color": "green",
                "value": 10737418240
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h], 86400), 0) and count_over_time(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h]) > 1000",
          "refId": "A"
        }
      ],
      "title": "Root free predicted in 24h",
      "type": "stat",
      "description": "6h-window linear regression, clamped at 0 (free space can't go negative - a raw predict_linear can dip below zero when the trend is steep, which just means 'exhausted before the horizon', not a real negative value). No data for the first ~15min after node_exporter (re)starts - not enough samples in the window yet."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5368709120
              },
              {
                "color": "green",
                "value": 10737418240
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\"}[3d], 7 * 24 * 3600), 0) and count_over_time(node_filesystem_avail_bytes{mountpoint=\"/\"}[3d]) > 12000 and (time() - node_boot_time_seconds) > 86400",
          "refId": "A"
        }
      ],
      "title": "Root free predicted in 7d",
      "type": "stat",
      "description": "3-day window on purpose, not 24h: verified live that a 24h window predicts -237 GiB on a freshly-booted box, because the first day's one-time costs (blocklist download, Grafana's first-run plugin installs, pre-compaction TSDB growth) get extrapolated as if they repeat daily. No data until the box has 3 real days of history AND has been up continuously for 24h+ since the last reboot - by design, not a bug. Feeds RootDiskFreePredictedLow (same expression, <10 GiB, for 30m)."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "-deriv(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h]) * 86400 / 1024 / 1024 / 1024",
          "refId": "A"
        }
      ],
      "title": "Root disk burn rate (GiB/day)",
      "type": "stat",
      "description": "Positive = draining, negative = free space growing back (e.g. after a log rotation or blocklist shrink). deriv() is a linear-regression slope over 6h, not an instantaneous rate() - smoother, but still noisier right after a reboot than at steady state; give a fresh boot a day before trusting this number."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 7
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\"} / clamp_min(-deriv(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h]), 1) / 86400) and (-deriv(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h]) > 1000) and count_over_time(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h]) > 1000",
          "refId": "A"
        }
      ],
      "title": "Root days until full",
      "type": "stat",
      "description": "Only shows a number while root is draining faster than ~1 KiB/s (~84 MiB/day) - below that, the division blows up into a meaningless multi-year figure, so it's gated to 'no data' instead of showing a fake number. No data = no imminent trend, not a broken panel."
    }
